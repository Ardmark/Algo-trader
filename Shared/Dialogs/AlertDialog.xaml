<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:Class="AlgoTrader.Shared.Windows.AlertDialog"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    WindowStartupLocation="CenterScreen" 
    SizeToContent="WidthAndHeight"
    MinWidth="400"
    MinHeight="200"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanMinimize">
    <StackPanel Margin="5">
        <TextBox Name="text" Margin="5" BorderThickness="0" TextWrapping="Wrap" VerticalContentAlignment="Stretch"/>
        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Center">
            <Button Content="_Ok" IsDefault="True" Margin="5" Padding="10,5,10,5" Name="btnOk" Click="BtnOk_Click"  />
            <Button Content="_Cancel" IsDefault="True" Margin="5" Padding="10,5,10,5" Name="btnCancel" Click="BtnCancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
