<Window x:Class="AlgoTrader.Shared.Windows.OrderPlacementMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        HorizontalContentAlignment="Center"
        Title="OrderMenu"
        SizeToContent="WidthAndHeight"
        >

    <Menu HorizontalAlignment="Stretch" Background="White">
        <Menu.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </Menu.ItemsPanel>

        <MenuItem Header="Order: Price Break (Long)"    Command="{Binding MenuItem0_Command}" />
        <MenuItem Header="Order: Price Break (Short)"   Command="{Binding MenuItem1_Command}" />
        <Separator />
        <MenuItem Header="MA Stop"                      Command="{Binding MenuItem7_Command}" />
        <MenuItem Header="Floor"                        Command="{Binding MenuItem4_Command}" />
        <MenuItem Header="Take profit at %"       Command="{Binding MenuItem8_Command}" />
        <Separator />
        <MenuItem Header="Ceiling"                      Command="{Binding MenuItem2_Command}" />
        <Separator />
        <MenuItem Header="Order: Market (Long)"         Command="{Binding MenuItem5_Command}" />
        <MenuItem Header="Order: Market (Short)"        Command="{Binding MenuItem6_Command}" />

    </Menu>
</Window>
