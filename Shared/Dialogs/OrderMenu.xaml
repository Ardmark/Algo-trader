<Window x:Class="AlgoTrader.Shared.Windows.OrderMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlgoTrader.Shared"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="OrderMenu"
        SizeToContent="WidthAndHeight"
        >

    <Menu HorizontalAlignment="Stretch" Background="White">
        <Menu.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </Menu.ItemsPanel>
        <MenuItem Header="! Congestion pattern"         Command="{Binding MenuItem0_Command}"></MenuItem>
        <MenuItem Header="! First break"                Command="{Binding MenuItem1_Command}"></MenuItem>
        <MenuItem Header="! Flag"                       Command="{Binding MenuItem2_Command}"></MenuItem>
        <MenuItem Header="! Flat range"                 Command="{Binding MenuItem3_Command}"></MenuItem>
        <MenuItem Header="! Retracement"                Command="{Binding MenuItem4_Command}"></MenuItem>
        <MenuItem Header="! Rising from retracement"    Command="{Binding MenuItem5_Command}"></MenuItem>
        <MenuItem Header="! Unclassified"               Command="{Binding MenuItem6_Command}"></MenuItem>
        <Separator></Separator>
        <MenuItem Header="! Weak"                       Command="{Binding MenuItem7_Command}"></MenuItem>
        <MenuItem Header="! Strong"                     Command="{Binding MenuItem8_Command}"></MenuItem>
        <Separator></Separator>        
        <MenuItem Header="Close trade"                  Command="{Binding MenuItem9_Command}"></MenuItem>
        <Separator></Separator>
        <MenuItem Header="Remove trade"                 Command="{Binding MenuItem10_Command}"></MenuItem>
        <MenuItem Header="Remove trade and line"        Command="{Binding MenuItem11_Command}"></MenuItem>
        <Separator />
        <MenuItem Header="Backtest trade"               Command="{Binding MenuItem12_Command}"></MenuItem>
        <!--       
        <MenuItem Header="Remove take profit" Command="{Binding MenuItem2_Command}"></MenuItem>
        <MenuItem Header="Run trade live" Command="{Binding MenuItem3_Command}"></MenuItem>
        -->
    </Menu>
</Window>
