<Window x:Class="AlgoTrader.Shared.Windows.TradeMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlgoTrader.Backtest"
        mc:Ignorable="d"
        WindowStyle="None"
        HorizontalContentAlignment="Center"
        Title="OrderMenu"
        SizeToContent="WidthAndHeight"
        >

    <Menu HorizontalAlignment="Stretch" Background="White">
        <Menu.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </Menu.ItemsPanel>
        <MenuItem Header="Set Market Break Order"    Command="{Binding MenuItem0_Command}"></MenuItem>
        <!--<MenuItem Header="Set Limit Order" IsEnabled="False"  Command="{Binding MenuItem1_Command}"></MenuItem>-->
        <Separator />
        <MenuItem Header="Set Fixed Stop"            Command="{Binding MenuItem1_Command}"></MenuItem>
        <Separator />
        <MenuItem Header="Set Floor Stop"         Command="{Binding MenuItem4_Command}"></MenuItem>
        <Separator />
        <MenuItem Header="Set Trailing Stop"         Command="{Binding MenuItem2_Command}"></MenuItem>
        <MenuItem Header="Set Incremental Stop"         Command="{Binding MenuItem3_Command}"></MenuItem>
        <Separator />
        <MenuItem Header="Set Take Profit"           Command="{Binding MenuItem5_Command}"></MenuItem>

        <!--    <MenuItem Header="Set Limit Order"     Command="{Binding MenuItem5_Command}" IsEnabled="False"></MenuItem>-->


    </Menu>
</Window>
