<Window x:Class="AlgoTrader.Shared.Windows.LineMenuShiftClick"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        HorizontalContentAlignment="Center"
        Title="OrderMenu"
        SizeToContent="WidthAndHeight"
        >

    <Menu HorizontalAlignment="Stretch" Background="White">
        <Menu.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </Menu.ItemsPanel>
        <MenuItem Header="Local Long line break Order (not placed on Exchange)"                Command="{Binding MenuItem0_Command}"></MenuItem>
        <MenuItem Header="Local Short line break Order (not placed on Exchange)"                Command="{Binding MenuItem1_Command}"></MenuItem>
    </Menu>
</Window>